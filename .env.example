# Secrets — copy to .env, NEVER commit to git

# ===== LLM Providers =====
# Set whichever ones you use; LiteLLM picks them up by env var name.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Ollama — local, usually no key needed, just make sure it's running
# OLLAMA_API_BASE=http://localhost:11434

# ===== Web search (Phase 2) =====
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ===== API server (Phase 3) =====
# Comma-separated list of allowed API keys for HTTP auth
# CODESMITH_API_KEYS=dev-key-1,dev-key-2
